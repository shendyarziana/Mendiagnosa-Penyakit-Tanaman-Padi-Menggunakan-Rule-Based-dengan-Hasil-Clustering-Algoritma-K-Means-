print("Centroid Akhir :")
print(centroids)

print("\nJumlah Iterasi :")
print(iteration)

print("\nK Optimal :")
print(best_k)

print("\nSilhouette Terbaik :")
print(best_score)

print("\nHASIL DIAGNOSA PENYAKIT DAUN PADI")


hasil_diagnosa = []

for i, c in enumerate(centroids):

    r, g, b = c

    penyakit = "Tidak Diketahui"

    if r > 170 and g > 140 and b < 100:
        penyakit = "Rice Tungro Virus"

    elif r > 160 and g < 140 and b < 100:
        penyakit = "Rice Blast"

    elif r > 120 and g > 90 and b < 80:
        penyakit = "Brown Spot"

    elif r < 90 and g < 90 and b < 90:
        penyakit = "Stem Rot"

    elif r > 170 and g > 170 and b < 140:
        penyakit = "Bacterial Leaf Blight"

    elif r > 130 and g > 120 and b > 100:
        penyakit = "Sheath Blight"

    elif r > 130 and g < 120 and b < 120:
        penyakit = "Sheath Rot"

    elif g > 140 and r > 120 and b < 100:
        penyakit = "False Smut"

    else:
        penyakit = "Daun Sehat"

    print(f"\nCluster {i+1}")

    print(
        f"RGB : R={r:.1f}, G={g:.1f}, B={b:.1f}"
    )

    print(
        "Diagnosa :",
        penyakit
    )

    hasil_diagnosa.append(
        penyakit
    )

hasil_akhir = Counter(
    [
        d
        for d in hasil_diagnosa
        if d not in [
            "Daun Sehat",
            "Tidak Diketahui"
        ]
    ]
).most_common(1)

print("\nKESIMPULAN AKHIR")

print(
    "Hasil Diagnosa :",
    hasil_akhir[0][0]
    if hasil_akhir
    else "Daun Sehat"
)
